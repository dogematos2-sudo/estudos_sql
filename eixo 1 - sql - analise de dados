SELECT country, tot_pop
FROM population
WHERE tot_pop > 0.2e9
AND ref_year = 2023;

SELECT country  , ref_year , co2_pc
FROM co2_emissions_pc 
WHERE ref_year BETWEEN 2019 AND 2021
  AND country IN ("Brazil", "China", "USA");

SELECT country, eight_regions 
FROM country 
WHERE wb4income = 'Lower middle income' 
  AND eight_regions IN ('europe_east', 'europe_west');

SELECT country , co2_pc , ref_year 
FROM co2_emissions_pc
WHERE ref_year BETWEEN 2019 AND 2021 
AND country IN  ('Brazil' , 'China' , 'USA');

SELECT country, eight_regions 
FROM country 
WHERE wb4income = 'Lower middle income' 
  AND eight_regions IN ('europe_east', 'europe_west');

SELECT country  , eight_regions , wb_regions
FROM country
WHERE eight_regions LIKE '%asia%';

SELECT wb_regions
FROM country
WHERE wb_regions  LIKE  "%America%";

SELECT country , gdp_pc , ref_year  
FROM gdp_pc
WHERE ref_year ("2009");
ORDER BY gdp_pc ASC;

SELECT my.country, my.mean_years , 'male' as gender
FROM men_years_at_school my
WHERE my.country IN  ('Brazil', 'Russia' , 'India' , 'China' , 'South Africa')
AND my.ref_year =  2000
UNION 
SELECT wy.country, wy.mean_years , 'famale' as gender
FROM women_years_at_school wy 
WHERE wy.country IN ('Brazil', 'Russia' , 'India' , 'China' , 'South Africa')
AND wy.ref_year =  2000


